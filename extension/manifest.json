{
  "manifest_version": 3,
  "name": "Switch FAANG - LinkedIn Job Saver",
  "version": "1.0.0",
  "description": "Save LinkedIn job search results directly to Switch FAANG application tracker",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": ["https://switch-faang.vercel.app/*", "https://www.linkedin.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/in/*"],
      "js": ["content-profile.js"],
      "run_at": "document_idle"
    }
  ]
}
